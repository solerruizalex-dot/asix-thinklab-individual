// Esquema de red del entorno individual - Álex Soler Ruiz
// Generar: dot -Tpng -Gdpi=110 red-individual.dot -o red-individual.png
graph red {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, bgcolor="white",
         label="Entorno individual ASIX ThinkLab — Álex Soler Ruiz\nLAN 192.168.30.0/24 · red interna VirtualBox «lan_grupo3» · dominio alexsoler.lan", labelloc=t];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f4f6f8", color="#5b6770"];
  edge  [color="#2a7f8f", penwidth=1.4, fontname="Helvetica", fontsize=9];

  internet [label="Internet", shape=ellipse, fillcolor="#dfe7ee"];
  casa [label="Router de casa\n192.168.1.1", fillcolor="#eeeeee"];
  subgraph cluster_host {
    label="PC anfitrión · Linux Mint 22.3 · VirtualBox 7.0.20\ni5-10400F · 16 GB · SSD de clase por USB 3.0\neno1 192.168.1.149/24"; style="rounded,dashed"; color="#888888"; fontsize=10;
    nat [label="NAT de VirtualBox\n(uno por VM)\n10.0.2.0/24 · gw 10.0.2.2", shape=box, fillcolor="#fff6db"];

    subgraph cluster_fw {
      label="Servidores de comunicaciones (WAN = NAT, IP por DHCP)"; style="rounded"; color="#c0392b"; fontsize=10;
      mk  [label="MikroTik-AlexSoler · RouterOS 7.24.6\nether1 WAN 10.0.2.15 (DHCP)\nether2 LAN 192.168.30.1/24\nPUERTA DE ENLACE + DHCP .100–.200\n256 MB · 2 vCPU", fillcolor="#fde2df"];
      opn [label="OPNsense-AlexSoler · 26.7.9\nem0 WAN 10.0.2.15 (DHCP)\nem1 LAN 192.168.30.2/24\nalternativo · 2 GB", fillcolor="#fde2df"];
      nft [label="nftables-AlexSoler · Debian 13.8\nenp0s3 WAN 10.0.2.15 (DHCP)\nenp0s8 LAN 192.168.30.3/24\nnftables + dnsmasq (DNS) · 1 GB", fillcolor="#fde2df"];
    }
    sw [label="Switch virtual\nred interna «lan_grupo3»\n192.168.30.0/24", shape=box3d, fillcolor="#e3f1f3"];

    subgraph cluster_srv {
      label="Servidores (IP fija · gw 192.168.30.1)"; style="rounded"; color="#2c6e9b"; fontsize=10;
      dc  [label="DC01-ALEX · Windows Server 2025\n192.168.30.21/24 · DNS 127.0.0.1\nAD DS + DNS alexsoler.lan · 4 GB", fillcolor="#dbe9f7"];
      tn  [label="truenas-alex · TrueNAS SCALE 24.04.2.5\n192.168.30.20/24\npool «copias» (disco 60 GB) · NFS + SMB · 2,5 GB", fillcolor="#dbe9f7"];
    }
    subgraph cluster_pve {
      label="Clúster Proxmox VE 9.2.32 «grupo3-cluster» (3 nodos, quórum 2/3)"; style="rounded"; color="#e67e22"; fontsize=10;
      pve1 [label="pve1\nvmbr0 192.168.30.32/24", fillcolor="#fdebd3"];
      pve2 [label="pve2\nvmbr0 192.168.30.33/24", fillcolor="#fdebd3"];
      pve3 [label="pve3\nvmbr0 192.168.30.34/24", fillcolor="#fdebd3"];
      serveis [label="VM 122 serveis · Debian 13.8\n192.168.30.22/24 · 384 MB", shape=component, fillcolor="#ffffff"];
      dades   [label="VM 123 dades · Debian 13.8\n192.168.30.23/24 · 384 MB\nRAID 0/1/5 (mdadm) + DRBD", shape=component, fillcolor="#ffffff"];
      ct      [label="CT 130 web-pruebas · Debian 13\n192.168.30.30/24 (migrado desde pve1)", shape=component, fillcolor="#ffffff"];
    }
    subgraph cluster_cli {
      label="Clientes (DHCP del MikroTik, DNS → DC)"; style="rounded"; color="#27ae60"; fontsize=10;
      w11 [label="administracion-AlexSoler\nWindows 11 Pro · PC-ADMIN01 · unido al dominio\nDHCP → 192.168.30.198", fillcolor="#dcf3e3"];
      lx  [label="informatica-linux-AlexSoler\nDebian 13.8 GNOME · pc-informatica · unido al dominio (SSSD)\nreserva DHCP 192.168.30.150", fillcolor="#dcf3e3"];
    }
  }
  internet -- casa -- nat;
  nat -- mk  [label=" WAN"]; nat -- opn [label=" WAN"]; nat -- nft [label=" WAN"];
  mk -- sw [label=" LAN"]; opn -- sw [style=dashed]; nft -- sw [style=dashed];
  sw -- dc; sw -- tn; sw -- pve1; sw -- pve2; sw -- pve3; sw -- w11; sw -- lx;
  pve1 -- serveis [style=dotted, label=" (migrada\n desde pve2)"]; pve3 -- dades [style=dotted]; pve2 -- ct [style=dotted];
  tn -- dades [style=dotted, color="#888888", label=" 7 discos RAID\n por NFS"];
  serveis -- dades [label=" DRBD\n(espejo en red)", style=dashed, color="#8e44ad"];
}
